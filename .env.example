# ==========================================================================
# NeoChat environment bootstrap
# Copy to .env and adjust. Only BOOTSTRAP values live here; runtime config
# is managed via the Configuration Service (DB-backed) once the server runs.
# Feature modules MUST NOT read process.env directly.
# Schema: packages/config/src/bootstrap.ts (@neochat/config)
# ==========================================================================

# --- Core ---
NODE_ENV=development
NEOCHAT_INSTANCE_NAME=NeoChat Dev

# HTTP entrypoint for Docker Stage-1 (nginx gateway publishes this port)
NEOCHAT_HTTP_PORT=8085

# API listen port (Nest uses PORT; bootstrap schema uses API_PORT)
PORT=3000
API_PORT=3000
API_HOST=0.0.0.0

# Public URLs — for Docker Stage-1 defaults, point at the gateway port
PUBLIC_API_URL=http://localhost:8085/api
PUBLIC_WEB_URL=http://localhost:8085
PUBLIC_ADMIN_URL=http://localhost:8085/admin

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://neochat:neochat@localhost:5432/neochat
POSTGRES_USER=neochat
POSTGRES_PASSWORD=neochat
POSTGRES_DB=neochat

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth / JWT ---
# Generate strong secrets in production (openssl rand -hex 32)
JWT_ACCESS_SECRET=dev-access-secret-change-me-0000000000000000
JWT_REFRESH_PEPPER=dev-refresh-pepper-change-me-0000000000000000
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Object storage (MinIO / S3) ---
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=neochat
MINIO_SECRET_KEY=neochat-secret
MINIO_BUCKET=neochat-media
MINIO_REGION=us-east-1

# --- Realtime calls (LiveKit — optional; enable with docker --profile livekit) ---
CALL_PROVIDER=none
LIVEKIT_URL=ws://localhost:17880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-change-me-000000000000

# --- Notifications (Web Push / VAPID) ---
NOTIFY_PROVIDER=webpush
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Search ---
SEARCH_PROVIDER=postgres

# --- First-run setup ---
# When true and no admin exists, /api/auth/setup wizard is enabled.
ALLOW_FIRST_RUN_SETUP=true

# --- Rate limiting ---
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120

# --- Observability ---
LOG_LEVEL=debug

# --- Stage-2 TLS (docker compose --profile caddy + deploy/docker-compose.tls.yml) ---
NEOCHAT_DOMAIN=chat.example.com
ACME_EMAIL=admin@example.com
NEOCHAT_HTTPS_PORT=443
NEOCHAT_HTTP_REDIRECT_PORT=80
# Manual certs (optional — mount host dir to /certs via TLS_CERT_DIR)
TLS_CERT_DIR=./deploy/certs
TLS_CERT_FILE=
TLS_KEY_FILE=

# --- Docker Compose host port overrides (optional) ---
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# MINIO_HOST_PORT=9000
# MINIO_CONSOLE_PORT=9001
# LIVEKIT_HOST_PORT=17880
