{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "composite": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@neochat/shared": ["packages/shared/src/index.ts"],
      "@neochat/config": ["packages/config/src/index.ts"],
      "@neochat/plugins": ["packages/plugins/src/index.ts"],
      "@neochat/sdk": ["packages/sdk/src/index.ts"],
      "@neochat/crypto": ["packages/crypto/src/index.ts"],
      "@neochat/i18n": ["packages/i18n/src/index.ts"],
      "@neochat/ui": ["packages/ui/src/index.ts"],
      "@neochat/providers": ["packages/providers/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".turbo"]
}
